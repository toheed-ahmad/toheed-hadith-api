[
  {
    "id": "1",
    "type": "quran",
    "text": "بیشک اللہ صبر کرنے والوں کے ساتھ ہے۔",
    "reference": "سورۃ البقرہ: 153"
  },
  {
    "id": "2",
    "type": "quran",
    "text": "اور نماز قائم کرو اور زکوٰۃ دو۔",
    "reference": "سورۃ البقرہ: 43"
  },
  {
    "id": "3",
    "type": "quran",
    "text": "اللہ تمہارے ساتھ آسانی چاہتا ہے۔",
    "reference": "سورۃ البقرہ: 185"
  },
  {
    "id": "4",
    "type": "quran",
    "text": "اور اللہ پر بھروسہ کرو۔",
    "reference": "سورۃ آل عمران: 122"
  },
  {
    "id": "5",
    "type": "quran",
    "text": "بیشک اللہ ہر چیز پر قادر ہے۔",
    "reference": "سورۃ البقرہ: 20"
  },
  {
    "id": "6",
    "type": "quran",
    "text": "اللہ ہی بہترین کارساز ہے۔",
    "reference": "سورۃ آل عمران: 173"
  },
  {
    "id": "7",
    "type": "quran",
    "text": "بیشک نماز بے حیائی سے روکتی ہے۔",
    "reference": "سورۃ العنکبوت: 45"
  },
  {
    "id": "8",
    "type": "quran",
    "text": "اور اپنے رب سے دعا کرو۔",
    "reference": "سورۃ الاعراف: 55"
  },
  {
    "id": "9",
    "type": "quran",
    "text": "اللہ گناہوں کو بخشنے والا ہے۔",
    "reference": "سورۃ الزمر: 53"
  },
  {
    "id": "10",
    "type": "quran",
    "text": "بیشک اللہ شکر کرنے والوں کو پسند کرتا ہے۔",
    "reference": "سورۃ آل عمران: 144"
  },
  {
    "id": "11",
    "type": "hadith",
    "text": "تم میں بہترین وہ ہے جو قرآن سیکھے اور سکھائے۔",
    "reference": "صحیح بخاری"
  },
  {
    "id": "12",
    "type": "hadith",
    "text": "اعمال کا دارومدار نیتوں پر ہے۔",
    "reference": "صحیح بخاری"
  },
  {
    "id": "13",
    "type": "hadith",
    "text": "مسلمان وہ ہے جس کی زبان اور ہاتھ سے دوسرے محفوظ رہیں۔",
    "reference": "صحیح بخاری"
  },
  {
    "id": "14",
    "type": "hadith",
    "text": "صفائی نصف ایمان ہے۔",
    "reference": "صحیح مسلم"
  },
  {
    "id": "15",
    "type": "hadith",
    "text": "آسانی کرو، سختی نہ کرو۔",
    "reference": "صحیح بخاری"
  },
  {
    "id": "16",
    "type": "hadith",
    "text": "جنت ماں کے قدموں تلے ہے۔",
    "reference": "سنن نسائی"
  },
  {
    "id": "17",
    "type": "hadith",
    "text": "مسکرانا بھی صدقہ ہے۔",
    "reference": "جامع ترمذی"
  },
  {
    "id": "18",
    "type": "hadith",
    "text": "سب سے بہتر صدقہ علم سکھانا ہے۔",
    "reference": "سنن بیہقی"
  },
  {
    "id": "19",
    "type": "hadith",
    "text": "اللہ تمہارے دلوں کو دیکھتا ہے۔",
    "reference": "صحیح مسلم"
  },
  {
    "id": "20",
    "type": "hadith",
    "text": "دین آسان ہے۔",
    "reference": "صحیح بخاری"
  }
]